# Discord
DISCORD_TOKEN=
# Optional. Used only for logging/diagnostics.
DISCORD_CLIENT_ID=

# Pinecone — query the existing n8n index; do not create a new one
PINECONE_API_KEY=
PINECONE_INDEX_NAME=webairy

# Gemini — must match the n8n ingestion embedding model
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# n8n does not set a task type on stored vectors. RETRIEVAL_QUERY is recommended for questions.
# Set to none if you need to match n8n's default embedding call exactly.
GEMINI_EMBEDDING_TASK_TYPE=RETRIEVAL_QUERY
# Optional fallback if ANSWER_PROVIDER=gemini
GEMINI_ANSWER_MODEL=gemini-3.5-flash

# Answers — OpenRouter Gemma 4. Embeddings stay on Gemini.
ANSWER_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Optional. Tried in order after OPENROUTER_API_KEY fails, then Gemini. Comma-separated.
OPENROUTER_FALLBACK_API_KEYS=
OPENROUTER_ANSWER_MODEL=google/gemma-4-31b-it

# RAG
PINECONE_TOP_K=5
# Cosine/dot-product: higher is better. Calibrate with python scripts/test_retrieve.py
RELEVANCE_THRESHOLD=0.62

# Channel → namespace mapping. Prefer channels.json (copy from channels.example.json).
# JSON object of Discord channel IDs to Pinecone namespaces.
# DISCORD_CHANNEL_NAMESPACES={"123456789012345678":"bilal","234567890123456789":"abdullah"}

# Tickets — answers go to a private channel. Member info stays visible to staff.
# TICKET_MODE=true
# TICKET_CATEGORY_ID=
# TICKET_STAFF_ROLE_ID=
# Optional. Private #leave-requests for Admin/HR. Created on startup if empty.
# LEAVE_REVIEW_CHANNEL_ID=
# HR_CATEGORY_ID=
# HOD_CATEGORY_ID=
# HOD role IDs / channel IDs can live in channels.json (hodRoleIds, hodChannels).
# Discord roles named "BI HOD", "CS HOD", "Marketing HOD" are detected automatically.

# true = Discord echo replies only, no Pinecone/AI (Phase 1)
ECHO_MODE=false

# debug during development, info in production
LOG_LEVEL=debug

# MySQL — local Workbench. Prefer a single DATABASE_URL.
# Example: DATABASE_URL=mysql://root:password@127.0.0.1:3306/hr
DATABASE_URL=
# Or split vars instead of DATABASE_URL:
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=
# MYSQL_DATABASE=hr
HR_ROLE_ID=
# Admin sits above HR and can override or reverse an HR decision.
# Defaults to the ticket Admin role when left blank.
HR_ADMIN_ROLE_ID=
# Optional. Line managers come from the Manager field on Employees; this role
# is only for people who should approve without being named as a manager.
MANAGER_ROLE_ID=
# Leave goes manager -> HR. Set false for HR-only approval.
LEAVE_TWO_STEP_APPROVAL=true
# Days granted when an employee record is first created. Existing balances
# are never overwritten, so changing these only affects new employees.
LEAVE_GRANT_ANNUAL=16
LEAVE_GRANT_SICK=8
LEAVE_GRANT_CASUAL=8
# Temporary mapping check. Set false to hide /whoami.
HR_WHOAMI_ENABLED=false

# The employer name used in replies. The Discord server is often called
# something else, and staff should hear the company name.
COMPANY_NAME=WebAiry
ASSISTANT_NAME=HR Assistant

# Leave request emails via the SendGrid HTTP API.
# Put SENDGRID_API_KEY in local .env only — never commit it.
SENDGRID_API_KEY=
EMAIL_FROM_ADDRESS=noreply@webairy.com
EMAIL_FROM_NAME=WebAiry HR
# Leave approved/cancel To. HOD Cc still comes from Employees.
HR_LEAVE_TO=syed.mohib@webairy.com
# true = log instead of actually calling SendGrid.
DRY_RUN=false
APP_BASE_URL=
EMAIL_OUTBOX_WORKER_ENABLED=false
EMAIL_OUTBOX_POLL_INTERVAL_MS=15000
SENDGRID_WEBHOOK_VERIFICATION_KEY=
